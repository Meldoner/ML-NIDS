[Unit]
Description=IDS Agent (Scapy Sniffer)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ids-agent
ExecStart=/usr/bin/python3 /opt/ids-agent/sniffer.py
Restart=on-failure
RestartSec=5
Environment=BACKEND_URL=http://127.0.0.1:8000/api/v1/traffic
Environment=BACKEND_API_KEY=change_me_api_key
Environment=BATCH_INTERVAL=1.5
Environment=BATCH_MAX_SIZE=500

[Install]
WantedBy=multi-user.target
