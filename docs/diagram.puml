@startuml IDS_MVP_Architecture
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam backgroundColor #FFFFFF

title Network IDS Architecture - MVP (Agent + Docker Stack)

' =======================================================
' HOST OS (AGENT)
' =======================================================
package "Host OS (Linux)" <<Deployment>> {
    node "Server Host" {
        component "Systemd Service\nids-agent.service" as Systemd
        component "IDS Agent\nsniffer.py" as Agent
        component "Network Interface\neth0/lo" as NIC
    }
}

package "Agent Internals" <<Component>> {
    component "SnifferEngine" as SnifferEngine
    component "FlowAggregator" as FlowAggregator
    component "AgentReporter" as AgentReporter
}

' =======================================================
' DOCKER COMPOSE STACK
' =======================================================
package "Docker Compose Stack" <<Deployment>> {
    node "analyzer container" as AnalyzerContainer {
        component "FastAPI\n/api/v1/traffic" as API
        component "RuleEngine" as RuleEngine
        component "InfluxDBWriter" as Writer
    }

    node "influxdb container" as InfluxContainer {
        database "InfluxDB 2.x" as Influx
    }

    node "grafana container" as GrafanaContainer {
        component "Grafana Dashboard" as Grafana
    }

    node "docker volumes" as Volumes
}

' =======================================================
' RULE SET (CURRENT)
' =======================================================
package "Rule Set" <<Logic>> {
    interface "BaseRule" as BaseRule

    component SynFloodRule
    component SynAckImbalanceRule
    component PortScanRule
    component HorizontalScanRule
    component MultiTargetScanRule
    component UdpFloodRule
    component IcmpFloodRule
    component LargeIcmpRule
    component TcpFlagAnomalyRule
}

' =======================================================
' ACTORS
' =======================================================
cloud "External Clients" as Clients
actor "User" as User

' =======================================================
' RELATIONSHIPS
' =======================================================
Clients --> NIC : Network traffic
Systemd --> Agent : Start/Stop
Agent ..> SnifferEngine
SnifferEngine --> FlowAggregator : Raw Packets
FlowAggregator --> AgentReporter : Flow Batches
AgentReporter ..> API : HTTP/JSON (+ API key)

API --> RuleEngine : Validate + Detect
RuleEngine ..> BaseRule
RuleEngine --> Writer : Alerts + Metrics
Writer --> Influx : Write

Grafana --> Influx : Read
User --> Grafana : Dashboards

InfluxContainer --> Volumes
GrafanaContainer --> Volumes

@enduml